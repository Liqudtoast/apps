rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Each signed-in person can read/write only their own data under users/{their uid}/...
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        // Only these Google accounts may use the apps. Add/remove emails as needed.
        && request.auth.token.email in ['connortufford@gmail.com'];
    }
  }
}
